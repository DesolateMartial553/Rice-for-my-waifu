#!/usr/bin/env bash
# Start (or restart) waybar with the Wang Lin config.
source "$(dirname "$(readlink -f "$0")")/lib.sh"
if [[ "$1" == restart ]] || pgrep -x waybar >/dev/null; then
    pkill -x waybar; for _ in $(seq 20); do pgrep -x waybar >/dev/null || break; sleep 0.1; done
fi
exec "$WL_SHARE/scripts/run" waybar
