#!/usr/bin/env bash
source "$(dirname "$(readlink -f "$0")")/lib.sh"
if [[ ${1:-} == restart && -f "$WL_STATE/desktop.lock" ]]; then
    read -r pid < "$WL_STATE/desktop.lock" || true
    if [[ ${pid:-} =~ ^[0-9]+$ ]] && [[ -r /proc/$pid/cmdline ]] && grep -zFq '/desktop/shell.py' "/proc/$pid/cmdline"; then
        kill -TERM "$pid"
        for _ in {1..30}; do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
    fi
fi
exec python "$WL_SHARE/desktop/shell.py" >>"$WL_STATE/desktop.log" 2>&1
