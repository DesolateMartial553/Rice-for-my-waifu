#!/usr/bin/env bash
# First login after installing: a welcome note with the handful of keys that
# matter, plus the searchable keybind list. Runs once (flag in $WL_STATE).
source "$(dirname "$(readlink -f "$0")")/lib.sh"
flag="$WL_STATE/welcomed"
[[ -e $flag && ${1:-} != --again ]] && exit 0
sleep 4   # let the bar and panels start first
notify-send -a "Wang Lin" -t 0 -i preferences-desktop "欢迎 · Welcome to your new desktop" \
"<b>Super</b> is the Windows key.

<b>Super + A</b>   open apps
<b>Super + T</b>   terminal
<b>Super + B</b>   web browser
<b>Super + E</b>   files
<b>Super + Q</b>   close a window
<b>Super + 1…5</b>   switch desktops
<b>Super + L</b>   lock the screen
<b>Super + /</b>   every shortcut (search it)

Click the icons on the top bar for Wi-Fi, sound, battery, calendar and power."
"$WL_SHARE/scripts/popup" keybinds 20
touch "$flag"
