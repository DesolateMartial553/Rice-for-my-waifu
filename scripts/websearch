#!/usr/bin/env bash
# Web search prompt (rofi) → default browser. HyDE: SUPER+SHIFT+/
pkill -x rofi && exit 0
q=$(rofi -dmenu -p "󰖟  search" -lines 0 -theme-str 'listview { lines: 0; }') || exit 0
[[ -n $q ]] || exit 0
exec "$(dirname "$(readlink -f "$0")")/run" xdg-open "https://duckduckgo.com/?q=$(jq -rn --arg q "$q" '$q|@uri')"
