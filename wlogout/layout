{ "label": "lock",     "action": "loginctl lock-session",                                   "text": "Lock",     "keybind": "l" }
{ "label": "logout",   "action": "~/.local/share/wanglin-rice/scripts/logout",              "text": "Log out",  "keybind": "e" }
{ "label": "suspend",  "action": "systemctl suspend",                                       "text": "Suspend",  "keybind": "u" }
{ "label": "reboot",   "action": "systemctl reboot",                                        "text": "Reboot",   "keybind": "r" }
{ "label": "shutdown", "action": "systemctl poweroff",                                      "text": "Shut down","keybind": "s" }
